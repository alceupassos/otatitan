# Credenciais: copie para `.env.local` (tem prioridade sobre `.env`) ou exporte no shell.
# O servidor carrega `.env` primeiro e depois `.env.local` (sobrescreve chaves).

# Provedores de IA (opcional — não usados pelo core do produto ainda)
GROK_API_KEY=
XAI_API_KEY=
AI_PROVIDER=grok
GROKAI_MODEL=grok-4.3-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_CHAT=deepseek-v4-flash
DEEPSEEK_MODEL_REASONER=deepseek-v4-reasoner
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Otatitan ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3040
APP_PORT=3040
LOG_LEVEL=debug

# Banco de dados (3 roles — ver scripts/db-init/01-roles.sh)
DATABASE_URL=postgresql://otatitan_app:otatitan_app_dev@localhost:5442/otatitan?schema=otatitan
DATABASE_MIGRATE_URL=postgresql://otatitan_owner:otatitan_owner_dev@localhost:5442/otatitan?schema=otatitan
PLATFORM_DATABASE_URL=postgresql://otatitan_platform:otatitan_platform_dev@localhost:5442/otatitan?schema=otatitan
DATABASE_POOL_MAX=10

# Auth (gerar com: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3040
AUTH_TRUST_HOST=true
SESSION_MAX_AGE_SECONDS=28800
PASSWORD_RESET_TTL_MINUTES=30
MFA_ISSUER=Otatitan
# Exatamente 32 bytes em base64 (openssl rand -base64 32). Cifra o segredo
# TOTP e os códigos de recuperação; a app não sobe sem uma chave válida.
ENCRYPTION_KEY=

# Redis / filas
REDIS_URL=redis://localhost:6389
QUEUE_PREFIX=otatitan
RESERVATION_HOLD_MINUTES=30

# Pagamentos. Provedor padrão: STRIPE | ASAAS | MANUAL.
PAYMENTS_DEFAULT_PROVIDER=MANUAL

# Stripe (fora de produção, use as chaves sk_test_/pk_test_).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=brl

# Asaas (PIX/boleto). ASAAS_SANDBOX=true aponta para api-sandbox.asaas.com;
# false vai para a API de produção, que movimenta dinheiro de verdade.
ASAAS_SANDBOX=true
# A chave do Asaas começa com '$'. Use SEMPRE a forma "\$..." — aspas
# duplas mais barra invertida. Aspas simples NÃO bastam: o dotenv-cli roda
# dotenv-expand depois de remover as aspas, e a chave chega vazia, sem
# erro. Os scripts de deploy (`set -a; . .env`) expandem no shell pelo
# mesmo motivo. Conferir com: npm run check:payments
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=

# Armazenamento (S3-compatível — MinIO local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=otatitan-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=10485760

# E-mail (dev — Mailpit)
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Otatitan <nao-responda@otatitan.local>"

# Segurança
RATE_LIMIT_ENABLED=true
TRUSTED_PROXY=false
