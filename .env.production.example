# Template do ambiente de produção. O arquivo real é `.env.production`,
# vive SÓ no servidor (/opt/otatitan/.env.production, modo 600) e nunca é
# versionado nem copiado para dentro da imagem (ver .dockerignore).
#
# Gerar cada segredo com: openssl rand -base64 32
# Nunca reaproveitar os valores de desenvolvimento do `.env`.

APP_URL=https://otatitan.giannasiadvogados.com.br

# Auth — AUTH_SECRET assina o JWT de sessão; ENCRYPTION_KEY cifra o
# segredo TOTP e os códigos de recuperação, e precisa ter exatamente
# 32 bytes em base64.
AUTH_SECRET=
ENCRYPTION_KEY=
SESSION_MAX_AGE_SECONDS=28800
PASSWORD_RESET_TTL_MINUTES=30

# Banco — o superusuário é só para bootstrap; a aplicação usa
# otatitan_app (sem BYPASSRLS). Ver scripts/db-init/01-roles.sh.
POSTGRES_SUPERUSER_PASSWORD=
OTATITAN_OWNER_PASSWORD=
OTATITAN_APP_PASSWORD=
OTATITAN_PLATFORM_PASSWORD=
DATABASE_POOL_MAX=10

# Superadmin de plataforma criado pelo seed. Deixar SUPERADMIN_PASSWORD
# vazio cria o usuário sem senha (entra por "esqueci minha senha").
SUPERADMIN_EMAIL=superadmin@otatitan.app
SUPERADMIN_PASSWORD=

# E-mail. Enquanto não houver SMTP real, o reset de senha falha em
# silêncio (por design, para não revelar quais e-mails existem) — o
# usuário pede o link e ele nunca chega.
SMTP_URL=
MAIL_FROM="Otatitan <nao-responda@otatitan.giannasiadvogados.com.br>"

# Pagamentos. MANUAL enquanto as chaves Stripe de produção não existirem.
PAYMENTS_DEFAULT_PROVIDER=MANUAL
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

LOG_LEVEL=info
