# Template do ambiente de produção. O arquivo real é `.env.production`,
# vive SÓ no servidor (/opt/otatitan/.env.production, modo 600) e nunca é
# versionado nem copiado para dentro da imagem (ver .dockerignore).
#
# Gerar cada segredo com: openssl rand -base64 32
# Nunca reaproveitar os valores de desenvolvimento do `.env`.

APP_URL=https://otatitan.giannasiadvogados.com.br

# Auth — AUTH_SECRET assina o JWT de sessão; ENCRYPTION_KEY cifra o
# segredo TOTP e os códigos de recuperação, e precisa ter exatamente
# 32 bytes em base64.
AUTH_SECRET=
ENCRYPTION_KEY=
SESSION_MAX_AGE_SECONDS=28800
PASSWORD_RESET_TTL_MINUTES=30

# Banco — o superusuário é só para bootstrap; a aplicação usa
# otatitan_app (sem BYPASSRLS). Ver scripts/db-init/01-roles.sh.
POSTGRES_SUPERUSER_PASSWORD=
OTATITAN_OWNER_PASSWORD=
OTATITAN_APP_PASSWORD=
OTATITAN_PLATFORM_PASSWORD=
DATABASE_POOL_MAX=10

# Superadmin de plataforma criado pelo seed. Deixar SUPERADMIN_PASSWORD
# vazio cria o usuário sem senha (entra por "esqueci minha senha").
SUPERADMIN_EMAIL=superadmin@otatitan.app
SUPERADMIN_PASSWORD=

# E-mail. Enquanto não houver SMTP real, o reset de senha falha em
# silêncio (por design, para não revelar quais e-mails existem) — o
# usuário pede o link e ele nunca chega.
SMTP_URL=
MAIL_FROM="Otatitan <nao-responda@otatitan.giannasiadvogados.com.br>"

# Pagamentos. ASAAS é o provedor do produto; MANUAL enquanto não houver
# chave. Confira o resultado no servidor com: npm run check:payments
PAYMENTS_DEFAULT_PROVIDER=ASAAS

# A chave do Asaas começa com '$', e AQUI ele se escreve DOBRADO: `$$aact_...`.
#
# Atenção: o escape é o OPOSTO do usado no `.env` de desenvolvimento. Este
# arquivo é lido só pelo `--env-file` do docker compose, que interpreta `$VAR`
# e `${VAR}` e usa `$$` como cifrão literal; o `.env` é lido pelo dotenv-cli,
# que quer `"\$..."`. A mesma chave, portanto, se escreve diferente nos dois.
#
# Medido com o compose deste projeto:
#   $$aact_prod_X  ->  chega "$aact_prod_X"   (correto)
#   \$aact_prod_X  ->  chega "\"              (destruída)
#   $aact_prod_X   ->  chega ""               (vazia, sem erro)
#
# As duas formas erradas falham em SILÊNCIO: o app sobe com provedor manual.
# Confira sempre com `npm run check:payments` — o deploy também o roda.
ASAAS_API_KEY=
# false = produção, e aí toda cobrança movimenta dinheiro de verdade. Tem de
# casar com o prefixo da chave ($aact_hmlg_ / $aact_prod_): config.ts recusa
# a combinação invertida, que só falharia na primeira cobrança real.
ASAAS_SANDBOX=false
# Segredo compartilhado que o Asaas devolve no header `asaas-access-token`.
# Não é a URL do endpoint — é o que prova que o evento veio dele. O mesmo
# valor tem de estar cadastrado no painel. Sem ele o webhook recusa todos os
# eventos e nenhuma reserva confirma sozinha (RN-009).
ASAAS_WEBHOOK_TOKEN=

# Stripe fica configurável para os webhooks de cobranças antigas.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

LOG_LEVEL=info

# Canal direto Madre 914 — o mesmo container, Host diferente.
# DNS/Cloudflare da zona madre914.com.br deve apontar para este nginx
# (ver infra/nginx/madre914.com.br.conf). Sem tenant slug, o site público
# mostra o marketing mas não cotação.
DIRECT_BOOKING_HOSTS=www.madre914.com.br,madre914.com.br
DIRECT_BOOKING_TENANT_SLUG=
DIRECT_BOOKING_PROPERTY_SLUG=madre-914
DIRECT_BOOKING_PUBLIC_URL=https://www.madre914.com.br

